{
  "name": "vite-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.12.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "lint:html": "markuplint \"src/**/*.html\"",
    "fix": "biome check --write . && pnpm lint:html",
    "prepare": "lefthook install",
    "lefthook:install": "lefthook install",
    "lefthook:run": "lefthook run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "browserslist": "^4.29.3",
    "lefthook": "^2.2.1",
    "lightningcss": "^1.33.0",
    "markuplint": "^5.1.0",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "vite": "^8.3.4",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-sitemap": "^0.8.2"
  },
  "browserslist": ["> 0.5%", "last 2 versions", "not dead"]
}
