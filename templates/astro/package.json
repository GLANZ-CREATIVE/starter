{
  "name": "astro-starter",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@12.12.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && stylelint \"**/*.{css,astro}\" && pnpm lint:html",
    "lint:html": "markuplint \"src/**/*.astro\"",
    "lint:fix": "eslint . --fix && stylelint \"**/*.{css,astro}\" --fix && pnpm lint:html",
    "check": "pnpm format:check && pnpm lint"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8",
    "astro-robots-txt": "^1.0.0",
    "astro-seo": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@markuplint/astro-parser": "^5.1.1",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "lefthook": "^2.2.1",
    "markuplint": "^5.1.1",
    "postcss": "^8.5.29",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript-eslint": "^8.71.1"
  }
}
