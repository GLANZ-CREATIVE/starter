---
interface Props {
  siteName?: string;
}

const { siteName = "Astro Starter" } = Astro.props;
---

<header class="header">
  <div class="header__inner">
    <a class="header__logo" href="/">
      {siteName}
    </a>
    <nav class="header__nav" aria-label="グローバルナビゲーション">
      <ul class="header__nav-list">
        <li>
          <a href="/">ホーム</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    border-block-end: 1px solid var(--color-border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-inline-size: 1200px;
    padding-block: 1rem;
    padding-inline: 1.5rem;
    margin-inline: auto;
  }

  .header__logo {
    font-size: 1.25rem;
    font-weight: 700;
  }

  .header__nav-list {
    display: flex;
    gap: 1.5rem;
  }
</style>
